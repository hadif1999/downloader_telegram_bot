# --- Telegram ---
BOT_TOKEN=123456:ABC-your-token-from-BotFather
# from https://my.telegram.org -> API development tools (needed by the local Bot API server)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
BOT_API_URL=http://telegram-bot-api:8081
BOT_API_LOCAL=true

# --- Optional required channel membership (empty ID disables the gate) ---
# Add the bot as an administrator of each channel. Comma-separated -100... IDs or @channel_usernames
# (up to 10); users must join all of them, e.g. -1001234567890,@public_channel
FORCE_JOIN_CHANNEL_ID=
# Join links matched to the IDs by position; leave a position empty for a public channel,
# e.g. https://t.me/+private_invite,
FORCE_JOIN_CHANNEL_URL=

# --- Platforms (true = enabled, false = disabled) ---
YOUTUBE_ENABLED=false
INSTAGRAM_ENABLED=false
TIKTOK_ENABLED=false
PINTEREST_ENABLED=false
SNAPCHAT_ENABLED=false
LIKEE_ENABLED=false
VK_ENABLED=false
FACEBOOK_ENABLED=false
THREADS_ENABLED=false
SOUNDCLOUD_ENABLED=false
SPOTIFY_ENABLED=false

# --- Queue ---
REDIS_URL=redis://redis:6379/0
# how many downloads run at the same time; the rest wait in the queue
MAX_PARALLEL_DOWNLOADS=2
TASK_TIME_LIMIT=3600
# Expire jobs that wait too long in the queue (seconds, maximum seven days).
QUEUE_TTL=86400

# --- Downloads ---
# local Bot API allows up to 2000 MB (cloud API: 50)
MAX_FILE_MB=2000
# Separate cap for source audio/video downloaded before MP3 conversion.
MAX_SOURCE_MB=4096
DOWNLOAD_DIR=/downloads
# Disk management: the most recent downloads are kept for retries (hardlinked, least recently used
# evicted first). Set MEDIA_CACHE_ITEMS=0 to delete every file right after delivery.
MEDIA_CACHE_ITEMS=3
MEDIA_CACHE_MAX_MB=4096
# seconds since last use
MEDIA_CACHE_TTL=21600
# new downloads are refused when less than this is free on the download volume
MIN_FREE_DISK_MB=1024
# Netscape cookie files per site, picked up automatically if present in ./cookies/:
#   youtube.txt instagram.txt facebook.txt tiktok.txt vk.txt pinterest.txt threads.txt ...
COOKIES_DIR=/cookies
POT_PROVIDER_URL=http://bgutil-provider:4416
