# --- Telegram ---
BOT_TOKEN=123456:ABC-your-token-from-BotFather
# from https://my.telegram.org -> API development tools (needed by the local Bot API server)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
BOT_API_URL=http://telegram-bot-api:8081
BOT_API_LOCAL=true

# --- Queue ---
REDIS_URL=redis://redis:6379/0
# how many downloads run at the same time; the rest wait in the queue
MAX_PARALLEL_DOWNLOADS=2
TASK_TIME_LIMIT=3600

# --- Downloads ---
# local Bot API allows up to 2000 MB (cloud API: 50)
MAX_FILE_MB=2000
DOWNLOAD_DIR=/downloads
# optional Netscape cookies file for YouTube (put it in ./cookies/)
# YTDLP_COOKIES=/cookies/youtube.txt
POT_PROVIDER_URL=http://bgutil-provider:4416
