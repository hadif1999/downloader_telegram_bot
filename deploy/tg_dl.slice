# Shared resource budget for every container of the tg_dl Compose project.
# Install: cp deploy/tg_dl.slice /etc/systemd/system/ && systemctl daemon-reload
[Unit]
Description=Telegram media downloader bot (shared resource budget)
Before=slices.target

[Slice]
CPUAccounting=yes
CPUQuota=100%
MemoryAccounting=yes
# Measured idle ~255 MB anon (+~45 MB margin for metadata lookups/startup) + 350 MB for a download.
# Reclaim/throttle first, hard OOM limit second; never push the bot into host swap.
MemoryHigh=620M
MemoryMax=650M
MemorySwapMax=0
TasksMax=1024
# Lower than the default 100 so other services on the host keep disk priority.
IOAccounting=yes
IOWeight=50
